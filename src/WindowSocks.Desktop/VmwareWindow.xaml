<Window x:Class="WindowSocks.Desktop.VmwareWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="虛擬機代理" Width="980" Height="760" MinWidth="850" MinHeight="620" WindowStartupLocation="CenterOwner">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="虛擬機代理" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="選擇要代理的 VMware 視窗，設定分配數量，儲存後在啟動時自動套用。" Margin="0,7,0,0" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="分配方式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Allocation" SelectionChanged="AllocationChanged"><ComboBoxItem Content="固定虛擬機"/><ComboBoxItem Content="依啟動順序（建議）"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="每個 IP 分配幾個視窗" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PerProxy" Text="1" MaxLength="2"/></StackPanel></Grid><CheckBox x:Name="OverflowToLocal" Content="超過分配數量時，使用本地網路" Margin="0,14,0,0"/><TextBlock Text="本地網路使用主機原本的網路連出。已分配的代理失效時維持封鎖。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><TextBlock x:Name="CaptureSummary" Text="正在尋找虛擬機…" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><Button x:Name="CaptureButton" Content="重新整理" Click="CaptureClick" HorizontalAlignment="Right" Margin="0"/></DockPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True"><DataGrid x:Name="Machines" IsReadOnly="False" RowHeight="54"><DataGrid.Columns>
    <DataGridTemplateColumn Header="選取" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="虛擬機" Binding="{Binding Name}" IsReadOnly="True" Width="1.2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    <DataGridTemplateColumn x:Name="FixedMappingColumn" Header="連線方式／代理 IP" Width="1.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding RouteChoice, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="目前分配" Binding="{Binding Assigned}" IsReadOnly="True" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="狀態" Binding="{Binding State}" IsReadOnly="True" Width="1.5*" ElementStyle="{StaticResource CellText}"/>
   </DataGrid.Columns></DataGrid></Border>
   <TextBlock Grid.Row="2" Text="首次設定時，程式會自動備份並準備網路；執行中的 VM 請正常關機一次，待顯示就緒後再啟動。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
   <Expander Header="進階設定與回復" Margin="0,0,0,12" FontSize="12"><StackPanel Margin="4,8,4,0"><TextBlock Text="專用網路" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Adapter" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,0,0,10"/><TextBlock x:Name="NetworkSummary" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><TextBlock Text="VMX 與 DHCP 會先備份；暫停代理不會切回 NAT。若需回復原網路，先將所選 VM 正常關機，再按回復。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><WrapPanel Margin="0,10,0,0"><Button x:Name="Add" Content="手動加入 VMX…" Click="AddClick"/><Button x:Name="Remove" Content="移除選取列" Click="RemoveClick"/><Button x:Name="Restore" Content="回復原網路" Click="RestoreClick"/></WrapPanel></StackPanel></Expander>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Pause" Content="暫停代理" Click="PauseClick"/><Button x:Name="Save" Content="儲存並啟用" Click="SaveClick" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel>
  </StackPanel>
 </Grid>
</Window>
