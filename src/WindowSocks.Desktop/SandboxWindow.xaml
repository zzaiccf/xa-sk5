<Window x:Class="WindowSocks.Desktop.SandboxWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="桌面沙盒多開" Width="960" Height="740" MinWidth="800" MinHeight="630" WindowStartupLocation="CenterOwner" AllowDrop="True" PreviewDragOver="DragOverFile" PreviewDrop="DropFile">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="新增遊戲與沙盒多開" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="選遊戲 → 選兩條線路 → 準備一次 → 直接啟動。A、B 各有獨立環境與固定線路。" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="官方安裝頁" Click="OpenSandboxDownload"/><Button DockPanel.Dock="Right" Content="重新檢查" Click="CheckEnvironment"/><TextBlock x:Name="EnvironmentText" Text="正在背景檢查 Sandboxie…" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Text="1. 選擇原始遊戲登入器（可拖入桌面捷徑）" Style="{StaticResource FieldLabel}"/>
    <DockPanel><Button DockPanel.Dock="Right" Content="選擇檔案" Click="Browse" Margin="10,0,0,0"/><TextBox x:Name="SourcePath" TextChanged="SourceChanged"/></DockPanel>
    <CheckBox x:Name="YongCompatibility" Content="套用 YongOrigin 相容設定" Margin="0,12,0,0" Checked="CompatibilityChanged" Unchecked="CompatibilityChanged"/>
    <TextBlock x:Name="CompatibilityHint" Text="辨識到 YongOrigin 時自動建議相容設定；每個環境使用固定且不同的裝置識別。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
    <Grid Margin="0,15,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="2. 實例 A 的固定線路" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="LineA" DisplayMemberPath="Label" SelectedValuePath="Id"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="實例 B 的固定線路（需與 A 不同）" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="LineB" DisplayMemberPath="Label" SelectedValuePath="Id"/></StackPanel>
    </Grid>
    <CheckBox x:Name="SimulateAdmin" Content="模擬管理員相容模式（適用需要管理員權限的登入器）" Margin="0,0,0,12"/>
    <WrapPanel><Button x:Name="PrepareButton" Content="3. 準備環境／保存" Style="{StaticResource PrimaryButton}" Click="Prepare"/><Button x:Name="CancelWork" Content="取消目前工作" Click="CancelPreparation" IsEnabled="False"/></WrapPanel>
    <TextBlock Text="第一次會複製兩份遊戲，完成後不必每次重建。可取消並接續；原始遊戲不變。修改設定前請先停止該遊戲的 A、B。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
   </StackPanel></Border>
   <WrapPanel Margin="0,16,0,8"><TextBlock Text="批量間隔" VerticalAlignment="Center"/><TextBox x:Name="LaunchInterval" Text="10" Width="55" Margin="8,0"/><TextBlock Text="秒（上一個完成後再等候）" VerticalAlignment="Center"/></WrapPanel>
   <WrapPanel Margin="0,0,0,12"><Button x:Name="StartAButton" Content="啟動 A" Click="StartA"/><Button x:Name="StartBButton" Content="啟動 B" Click="StartB"/><Button x:Name="StartBothButton" Content="批量啟動 A、B" Click="StartBoth"/><Button x:Name="StopButton" Content="停止選取實例" Click="StopSelected"/><Button Content="重新整理" Click="RefreshClick"/></WrapPanel>
   <TextBlock Text="準備完成後，也可回到「規則管理」右鍵實例 → 啟動。已在執行的實例會略過；遊戲帳密仍在遊戲視窗輸入。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
   <DataGrid x:Name="Instances" Height="190" SelectionMode="Single" IsReadOnly="True"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGrid.RowStyle><DataGrid.Columns>
    <DataGridTextColumn Header="實例" Binding="{Binding Profile.Name}" Width="140" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="固定線路／實測出口" Binding="{Binding Line}" Width="2*" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="狀態" Binding="{Binding State}" Width="1.3*" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="成員" Binding="{Binding Members}" Width="55" ElementStyle="{StaticResource CellText}"/>
   </DataGrid.Columns></DataGrid>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="關閉" Click="CloseWindow" Margin="12,0,0,0" VerticalAlignment="Bottom"/><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ProgressText" TextWrapping="Wrap" VerticalAlignment="Center"/></ScrollViewer></DockPanel>
 </Grid>
</Window>
