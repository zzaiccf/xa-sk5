<Window x:Class="WindowSocks.Desktop.GlobalProxyWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="全局代理" Width="680" Height="650" MinWidth="600" MinHeight="540" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="全局代理" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="本機程式，共用指定出口。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Padding="22"><StackPanel>
   <TextBlock Text="代理節點" Style="{StaticResource FieldLabel}"/>
   <ComboBox x:Name="Proxy" SelectedValuePath="Id" HorizontalContentAlignment="Stretch" Margin="0,0,0,22"><ComboBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4" ToolTip="{Binding Label}"><TextBlock Text="{Binding ExitIp}" FontWeight="SemiBold" FontSize="14"/><TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="AccountPort"/><Binding Path="EntryIp"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <CheckBox x:Name="BypassLan" Content="區域網路直連" IsChecked="True" ToolTip="保留 IPv4 區網探索、DHCP 與共享；DNS 53 埠仍經代理轉送。"/>
   <CheckBox x:Name="BypassRemoteControl" Content="遠端控制程式直連" IsChecked="True" Margin="0,16,0,0" ToolTip="預設讓常用遠端程式及 Windows RDP 的 TCP／UDP 直接連線，避免代理繞路。指定程序代理或封鎖規則仍優先。需要 0.1.11 背景服務與原生核心。"/>
   <TextBlock Text="RustDesk／RDxaomao 系列、AnyDesk、Chrome 遠端等" FontSize="11" Foreground="{StaticResource Muted}" Margin="22,6,0,0" TextWrapping="Wrap" ToolTip="RDxaomao.exe、RDxaomaoHost.exe、RDxaomaoControl.exe 已列入預設直連，需要 0.1.14 背景服務。其他改名版本可在下方加入完整程式路徑。"/>
   <Expander x:Name="CustomRemoteExpander" Header="其他遠端程式" FontSize="12" Foreground="{StaticResource Muted}" Margin="22,12,0,0"><StackPanel Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Button Content="加入程式…" Click="AddRemoteProgram"/><Button Content="移除" Click="RemoveRemoteProgram" Margin="0"/></StackPanel><ListBox x:Name="RemotePrograms" ItemsSource="{Binding}" MaxHeight="100" Margin="0,8,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" Margin="6" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Expander>
   <Border Background="#FFF8EB" CornerRadius="8" Padding="12" Margin="0,20,0,0"><TextBlock Text="啟用後接管其餘 TCP／UDP；檢測失敗時，其餘外網保持封鎖。已透過代理的連線需重新建立。" TextWrapping="Wrap" FontSize="12" Foreground="#A77A29"/></Border>
   <Expander Header="代理範圍與限制" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,0"><StackPanel Margin="6,10,6,0"><TextBlock Text="遠端直連優先於全局代理；指定程序、暫停封鎖及遊戲組規則仍優先。本機控制與 ADB 保留直連；共用 DNS 經代理轉送至 1.1.1.1，其餘外網 IPv6 保持封鎖。" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="不涵蓋橋接網卡、Hyper-V／WSL 轉送流量、ICMP，亦不保證所有反作弊遊戲相容。服務的代理上游與檢測連線保留直連；服務／驅動崩潰不保證零直連。" TextWrapping="Wrap"/></StackPanel></Expander>
  </StackPanel></Border></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="Error" Foreground="#C75353" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True"/><Button x:Name="EnableGlobalButton" Content="啟用全局代理" Style="{StaticResource PrimaryButton}" Click="Confirm" IsDefault="True" Margin="0"/></StackPanel></StackPanel>
 </Grid>
</Window>
