<Window x:Class="WindowSocks.Desktop.MainWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="xa sk5" Width="1280" Height="820" MinWidth="1040" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="14,28,14,18">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="8,0,0,34" ToolTip="小貓科技 · xa sk5"><Border Background="#F2F4F8" Width="42" Height="42" CornerRadius="12"><Image x:Name="SidebarLogo" Source="{StaticResource XiaomaoMark}" Width="34" Height="22" Stretch="Uniform" AutomationProperties.Name="小貓科技 Logo"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="xa sk5" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="SOCKS5 CLIENT" FontSize="8" Foreground="{StaticResource Muted}" Margin="1,4,0,0"/></StackPanel></StackPanel>
     <TextBlock Text="工作區" FontSize="10" Foreground="#A4AEBE" Margin="12,0,0,8"/>
     <StackPanel x:Name="SidebarNavigation">
      <Button Style="{StaticResource NavButton}" Tag="0" Click="Navigate" Background="{StaticResource SoftBlue}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="窗口列表"/></StackPanel></Button>
      <Button x:Name="RulesNavigation" Style="{StaticResource NavButton}" Tag="1" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="規則管理"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="2" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="代理與檢測"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="3" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="設定"/></StackPanel></Button>
     </StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,16,0,0"><StackPanel><TextBlock Text="xa sk5" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ProductVersionText" Text="預覽版" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="Workspace" Grid.Column="1" Margin="28,26,28,16" SizeChanged="WorkspaceSizeChanged">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="窗口列表" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="正在執行的窗口、虛擬機與目前使用的 IP 線路。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    <Border x:Name="GlobalBadge" Grid.Column="1" CornerRadius="16" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="11,7" VerticalAlignment="Top" Margin="0,3,8,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="GlobalIndicator" Width="6" Height="6" Fill="#99A5B8" Margin="0,0,7,0"/><TextBlock x:Name="GlobalStatus" Text="全局狀態讀取中" FontSize="11" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/></StackPanel></Border>
    <Border x:Name="ModeBadge" Grid.Column="2" CornerRadius="16" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="11,7" VerticalAlignment="Top" Margin="0,3,12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ModeIndicator" Width="6" Height="6" Fill="#99A5B8" Margin="0,0,7,0"/><TextBlock x:Name="ModeText" Text="連線中" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
    <Button x:Name="MainRefresh" Grid.Column="3" Click="RefreshClick" Style="{StaticResource QuietButton}" Padding="10" Margin="0,1,0,0" VerticalAlignment="Top" ToolTip="重新整理"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
   </Grid>
   <Border x:Name="GlobalBanner" Grid.Row="1" CornerRadius="12" BorderThickness="1" Padding="18,14" Margin="0,0,0,16" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock x:Name="GlobalBannerIcon" Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="GlobalHeading" FontSize="16" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="GlobalNodeName" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Grid>
     <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ManageGlobal" Content="調整線路" Click="GlobalProxyClick" Padding="12,7" FontSize="12"/><Button x:Name="StopGlobalBanner" Content="停用全局" Click="StopGlobalClick" Padding="12,7" Margin="0" FontSize="12" ToolTip="停用全局代理，指定窗口代理規則仍繼續運作。"/></StackPanel>
     <TextBlock x:Name="GlobalHint" Grid.Row="1" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="28,6,14,0"/>
     <Grid x:Name="GlobalNodeDetails" Grid.Row="2" Grid.ColumnSpan="2" Margin="28,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock x:Name="GlobalExitLabel" Text="實際 IP" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/><TextBlock x:Name="GlobalExitIp" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="連接帳號／端口" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/><TextBlock x:Name="GlobalAccountPort" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="連入 IP" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/><TextBlock x:Name="GlobalEntryIp" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
     </Grid>
     <WrapPanel x:Name="GlobalPolicies" Grid.Row="3" Grid.ColumnSpan="2" Margin="28,11,0,0"><StackPanel Orientation="Horizontal" Margin="0,0,20,0" ToolTip="本次全局代理生效時長；停用、換線、核心重啟或線路受阻後重新計時。重新開啟介面仍沿用背景服務的起始時間。"><TextBlock Text="代理時長：" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="GlobalDuration" Text="—" FontSize="11" FontFamily="Consolas"/></StackPanel><TextBlock x:Name="GlobalRemotePolicy" FontSize="11" Margin="0,0,20,0"/><TextBlock x:Name="GlobalLanPolicy" FontSize="11" Foreground="{StaticResource Muted}"/></WrapPanel>
    </Grid>
   </Border>
   <UniformGrid x:Name="SummaryCards" Grid.Row="2" Columns="3" Margin="0,0,-12,20">
    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0"><DockPanel><Border Background="#EEF2FF" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0"><TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock x:Name="TargetCountLabel" Text="執行中窗口" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="TargetCount" Text="0" FontSize="24" FontWeight="SemiBold"/></StackPanel></DockPanel></Border>
    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0"><DockPanel><Border Background="#EEF5FF" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0"><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#4E84D9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="代理節點" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="ProxyCount" Text="0" FontSize="24" FontWeight="SemiBold"/></StackPanel></DockPanel></Border>
    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0"><DockPanel><Border Background="#EAF8F0" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#218552" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="TCP / UDP 可用" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="ReadyCount" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="#218552"/></StackPanel></DockPanel></Border>
   </UniformGrid>
   <TabControl x:Name="Pages" Grid.Row="3" BorderThickness="0" Background="Transparent" Padding="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
    <TabItem><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="添加代理" Style="{StaticResource PrimaryButton}" Click="AutoProxyClick"/>
      <Button x:Name="RuntimeBind" Grid.Column="1" Content="分配節點" Click="BindClick"/>
      <Menu x:Name="RuntimeMenu" Grid.Column="2"><MenuItem Header="更多" Style="{StaticResource ToolbarMenuItem}"><MenuItem x:Name="EnableTargetAction" Header="啟用／啟動模擬器" Click="EnableClick"/><MenuItem x:Name="PauseTargetAction" Header="暫停並封鎖" Click="PauseClick"/><MenuItem x:Name="UnbindTargetAction" Header="解除綁定" Click="UnbindClick"/><Separator/><MenuItem x:Name="CloseAllProxyProcesses" Header="關閉所有代理進程" Click="CloseAllProxyProcessesClick" IsEnabled="False" Foreground="#C24141"/><Separator/><MenuItem Header="暫停自動代理" Click="PauseAutoClick"/><MenuItem Header="加入一般程序" Click="ProcessClick"/><MenuItem Header="VMware 虛擬機…" Click="VmwareClick"/><MenuItem x:Name="StopGlobal" Header="停用全局代理" Click="StopGlobalClick"/></MenuItem></Menu>
      <ComboBox x:Name="WindowFilter" Grid.Column="3" SelectedIndex="0" SelectionChanged="WindowFilterChanged" Width="145" HorizontalAlignment="Right" Margin="12,0,12,0"><ComboBoxItem Content="執行中窗口"/><ComboBoxItem Content="全部窗口"/></ComboBox><StackPanel Grid.Column="4" Orientation="Horizontal"><Button x:Name="RuntimePicker" Style="{StaticResource QuietButton}" PreviewMouseLeftButtonDown="PickDown" PreviewMouseLeftButtonUp="PickUp" ToolTip="按住並拖曳到其他程式窗口"><Grid Width="16" Height="16"><Ellipse Width="10" Height="10" Stroke="{StaticResource Muted}" StrokeThickness="1.3"/><Path Data="M 8,0 L 8,4 M 8,12 L 8,16 M 0,8 L 4,8 M 12,8 L 16,8" Stroke="{StaticResource Muted}" StrokeThickness="1.3"/></Grid></Button><Button x:Name="GlobalProxyButton" Content="全局代理" Click="GlobalProxyClick" Margin="0"/></StackPanel>
     </Grid>
     <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True"><Grid>
      <DataGrid x:Name="TargetGrid" SelectionChanged="TargetSelectionChanged"><DataGrid.Columns>
       <DataGridTemplateColumn Header="窗口／實例" Width="1.4*" MinWidth="195"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" ToolTip="{Binding Members}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding InstanceDetail}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="代理線路" Binding="{Binding Proxy}" ElementStyle="{StaticResource CellText}" Width="115"/>
       <DataGridTextColumn Header="實際 IP" Binding="{Binding Exit}" ElementStyle="{StaticResource CellText}" Width="120"/>
       <DataGridTemplateColumn Header="連接帳號／端口" CellTemplate="{StaticResource NodeAccountPortCell}" Width="145"/>
       <DataGridTextColumn Header="連入 IP" Binding="{Binding EntryIp}" ElementStyle="{StaticResource CellText}" Width="125"/>
       <DataGridTemplateColumn Header="狀態" CellTemplate="{StaticResource TargetStateCell}" Width="120"/>
       <DataGridTextColumn Header="連入時長" Binding="{Binding ConnectionDuration}" Width="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="ToolTip" Value="{Binding ConnectionHint}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTemplateColumn Header="流量" CellTemplate="{StaticResource TargetTrafficCell}" Width="110"/>
      </DataGrid.Columns></DataGrid>
      <StackPanel Visibility="Collapsed" x:Name="TargetEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Border Width="56" Height="56" CornerRadius="18" Background="{StaticResource SoftBlue}" HorizontalAlignment="Center" Margin="0,0,0,14"><TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="TargetEmptyTitle" Text="尚無管理中的窗口" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="TargetEmptyHint" Text="設定自動代理，或從「更多」加入程序。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
     </Grid></Border>
     <Grid Grid.Row="2" Margin="2,12,2,0"><TextBlock x:Name="AutoStatus" Text="手動模式" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
    </Grid></TabItem>
    <TabItem><Grid x:Name="RulesPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button Content="添加規則" Style="{StaticResource PrimaryButton}" Click="AutoProxyClick"/><Button Content="虛擬機規則" Click="VmwareClick"/><Button Content="編輯選取規則" Click="EditRuleClick"/></StackPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True"><Grid>
            <DataGrid x:Name="RuleGrid" SelectionMode="Single" MouseDoubleClick="EditRuleClick" PreviewMouseRightButtonDown="RuleGridRightMouseDown" ContextMenuOpening="RuleContextOpening" PreviewKeyDown="RuleGridKeyDown">
       <DataGrid.ContextMenu><ContextMenu Background="White" BorderBrush="{StaticResource Line}"><MenuItem Header="編輯規則" Click="EditRuleClick"/><MenuItem x:Name="ContextDeleteRule" Header="刪除此規則" Click="DeleteRuleClick"/></ContextMenu></DataGrid.ContextMenu>
       <DataGrid.Columns>
        <DataGridTextColumn Header="規則／目標" Binding="{Binding Name}" Width="1.8*" MinWidth="170"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        <DataGridTextColumn Header="類型" Binding="{Binding Type}" Width="90" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="分配方式" Binding="{Binding Allocation}" Width="110" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="IP／窗口數量" Binding="{Binding Capacity}" Width="200" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="管理窗口" Binding="{Binding Members}" Width="130" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="狀態" Binding="{Binding State}" Width="1*" MinWidth="135"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel x:Name="RuleEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="尚無代理規則" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="按「添加規則」設定，儲存後會列在這裡。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>

     </Grid></Border><TextBlock x:Name="RuleListSummary" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,12,2,0"/>
    </Grid></TabItem>
    <TabItem><Grid x:Name="ProxyPage" SizeChanged="ProxyPageSizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
      <Button Content="＋ 匯入節點" Click="ImportClick" Style="{StaticResource PrimaryButton}"/>
      <Button Grid.Column="1" Content="分配" Click="AssignFromProxyClick" ToolTip="使用代理池全部節點，依數量分配窗口"/>
      <Button x:Name="ManualProbe" Grid.Column="2" Content="立即檢測" Click="ManualProbeClick" IsEnabled="False" ToolTip="有選取時只檢測選取節點，未選取時檢測全部，最多 5 條並行。不會恢復已暫停的自動檢測。"/>
      <Menu Grid.Column="3"><MenuItem Header="更多" Style="{StaticResource ToolbarMenuItem}"><MenuItem Header="從檔案匯入" Click="ImportFileClick"/><MenuItem Header="匯出節點" Click="ExportClick" ToolTip="匯出不含密碼的 CSV"/><Separator/><MenuItem x:Name="ProbeSelected" Header="檢測選取節點" Click="ProbeClick" IsEnabled="False"/><MenuItem Header="檢測全部節點" Click="ProbeAllClick"/><MenuItem x:Name="StopProbe" Header="暫停自動檢測" Click="StopProbeClick" IsEnabled="False"/><MenuItem x:Name="ResumeProbe" Header="繼續自動檢測" Click="ResumeProbeClick" Visibility="Collapsed"/><Separator/><MenuItem Header="自動分配規則" Click="AutoProxyClick"/><MenuItem x:Name="DeleteSelected" Header="刪除選取節點" Click="DeleteClick" IsEnabled="False"/></MenuItem></Menu>
      <Button x:Name="ClearAllProxyIps" Grid.Column="4" Content="清除所有 IP" Click="ClearAllProxyIpsClick" Foreground="#C24141" HorizontalAlignment="Left" IsEnabled="False"/>
      <TextBox x:Name="ProxySearch" Grid.Column="5" Tag="搜尋 IP、帳號或名稱" TextChanged="ProxySearchChanged" ToolTip="搜尋節點名稱、連入 IP、實際 IP 或帳號"/>
     </Grid>
     <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DataGrid x:Name="ProxyGrid" SelectionChanged="ProxySelectionChanged" PreviewMouseLeftButtonDown="ProxyGridMouseDown" PreviewMouseRightButtonDown="ProxyGridRightMouseDown" ContextMenuOpening="ProxyContextOpening" PreviewKeyDown="ProxyGridKeyDown" ToolTip="右鍵可刪除、修改或檢測節點。再次點擊可取消選取；Ctrl／Shift 可多選。">
       <DataGrid.ContextMenu><ContextMenu Background="White" BorderBrush="{StaticResource Line}"><ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5"><ItemsPresenter/></Border></ControlTemplate></ContextMenu.Template><ContextMenu.Resources><Style TargetType="MenuItem"><Setter Property="MinWidth" Value="138"/><Setter Property="Padding" Value="14,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuBorder" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBorder" Property="Background" Value="{StaticResource SoftBlue}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ContextMenu.Resources><MenuItem x:Name="ContextDeleteProxy" Header="刪除" Click="ContextDeleteProxyClick"/><MenuItem x:Name="ContextEditProxy" Header="修改" Click="ContextEditProxyClick"/><MenuItem x:Name="ContextProbeProxy" Header="檢測" Click="ContextProbeProxyClick"/></ContextMenu></DataGrid.ContextMenu>
       <DataGrid.Columns>
       <DataGridTemplateColumn Header="實際 IP" CellTemplate="{StaticResource ProxyExitCell}" Width="1*" MinWidth="130"/>
       <DataGridTemplateColumn Header="連接帳號／端口" CellTemplate="{StaticResource NodeAccountPortCell}" Width="1.2*" MinWidth="150"/>
       <DataGridTextColumn Header="連入 IP" Binding="{Binding EntryIp}" Width="1.05*" MinWidth="125"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="ToolTip" Value="{Binding EntryIp}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn Header="到期時間" Binding="{Binding Expiration}" ElementStyle="{StaticResource CellText}" Width="108"/>
       <DataGridTemplateColumn Header="狀態" CellTemplate="{StaticResource ProxyHealthCell}" Width="120"/>
       <DataGridTextColumn Binding="{Binding Latency}" ElementStyle="{StaticResource CellText}" Width="88"><DataGridTextColumn.Header><TextBlock Text="連線延遲" ToolTip="本機到代理入口的 TCP 建立時間（含入口 DNS），不是遊戲延遲。完整 TCP 檢測耗時與 UDP 往返可在節點詳細資料查看。"/></DataGridTextColumn.Header></DataGridTextColumn>
       <DataGridTextColumn Header="分配" Binding="{Binding Usage}" ElementStyle="{StaticResource CellText}" Width="60"/>
      </DataGrid.Columns></DataGrid>
      <StackPanel x:Name="ProxyEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Border Width="56" Height="56" CornerRadius="18" Background="{StaticResource SoftBlue}" HorizontalAlignment="Center" Margin="0,0,0,14"><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="ProxyEmptyTitle" Text="匯入你的第一個節點" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="ProxyEmptyHint" Text="貼上代理資料，實際 IP 會自動檢測。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,9"><Grid><StackPanel Orientation="Horizontal"><TextBlock x:Name="ProxyListSummary" Text="0 個節點" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="ClearProxySelection" Content="清除選取" Click="ClearProxySelectionClick" Style="{StaticResource QuietButton}" FontSize="11" Padding="7,2" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="取消所有節點選取。"/></StackPanel><TextBlock x:Name="ProbeStateText" Text="每 30 分鐘複測" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="開啟與匯入時檢測一次；成功後 30 分鐘複測，失敗後 5 分鐘重試。需要最新結果可按「立即檢測」。"/></Grid></Border>
     </Grid></Border>
     <Border x:Name="ProxyDetailCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed" Padding="12,8">
      <Expander x:Name="ProxyDetailExpander" IsExpanded="False"><Expander.Header><Grid><TextBlock x:Name="ProxyDetailTitle" Text="節點詳情" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Grid></Expander.Header>
