<Window x:Class="WindowSocks.Desktop.AssignmentWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="分配節點" Width="1120" Height="720" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="分配節點" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ProxySummary" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14"><WrapPanel VerticalAlignment="Center"><TextBlock Text="每個節點" VerticalAlignment="Center"/><TextBox x:Name="Limit" Text="2" Width="54" Margin="10,0" TextAlignment="Center" TextChanged="Change"/><TextBlock Text="個窗口" VerticalAlignment="Center" Margin="0,0,22,0"/><ComboBox x:Name="MatchMode" Width="135" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="全部欄位"/><ComboBoxItem Content="程序檔名"/><ComboBoxItem Content="執行檔路徑"/><ComboBoxItem Content="窗口標題"/></ComboBox><TextBox x:Name="Search" Tag="搜尋窗口" Width="170" Margin="8,0,12,0" TextChanged="FilterChanged"/><Button Content="全選結果" Click="SelectFiltered" Padding="10,8"/><Button Content="清除" Click="ClearSelection" Style="{StaticResource QuietButton}" Padding="10,8" Margin="0"/></WrapPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True"><DataGrid x:Name="Candidates" IsReadOnly="False" CanUserSortColumns="False"><DataGrid.Columns>
   <DataGridTemplateColumn Header="" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="選取此窗口"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTextColumn Header="窗口／實例" Binding="{Binding Target.Name}" ElementStyle="{StaticResource CellText}" IsReadOnly="True" Width="1.2*" MinWidth="155"/>
   <DataGridTextColumn Header="實際 IP" Binding="{Binding Node.ExitIp, TargetNullValue=—}" ElementStyle="{StaticResource CellText}" IsReadOnly="True" Width="130"/>
   <DataGridTemplateColumn Header="連接帳號／端口" CellTemplate="{StaticResource NodeAccountPortCell}" IsReadOnly="True" Width="175"/>
   <DataGridTextColumn Header="連入 IP" Binding="{Binding Node.EntryIp, TargetNullValue=—}" ElementStyle="{StaticResource CellText}" IsReadOnly="True" Width="140"/>
   <DataGridTextColumn Header="程序 / PID" Binding="{Binding Identity}" IsReadOnly="True" Width="1.1*" MinWidth="155"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="ToolTip" Value="{Binding Target.Path}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
  </DataGrid.Columns></DataGrid></Border>
  <StackPanel Grid.Row="3" Margin="0,16,0,16"><WrapPanel><CheckBox x:Name="EnableAfter" Content="分配後啟用" ToolTip="完成檢測後啟用代理，既有遊戲連線須自行重新連線。" Margin="0,0,22,8"/><CheckBox x:Name="Children" Content="接續遊戲與子程序" IsChecked="True" ToolTip="一般窗口預設持續追蹤登入後啟動的遊戲；模擬器與遊戲組使用各自的成員規則。" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="ModeHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" IsCancel="True"/><Button x:Name="Apply" Content="確認分配" Style="{StaticResource PrimaryButton}" Click="Confirm" Margin="0"/></StackPanel></Grid>
 </Grid>
</Window>