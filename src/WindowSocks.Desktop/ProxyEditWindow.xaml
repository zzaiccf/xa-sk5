<Window x:Class="WindowSocks.Desktop.ProxyEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="修改節點" Width="550" Height="680" MinWidth="460" MinHeight="540" WindowStartupLocation="CenterOwner">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="修改節點" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="保留原有窗口分配，連線資料修改後重新檢測。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Padding="20"><StackPanel>
   <TextBlock Text="名稱" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NodeName" MaxLength="200" Margin="0,0,0,14"/>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="連入 IP／主機名稱" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Host" MaxLength="253"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Port" MaxLength="5"/></StackPanel></Grid>
   <TextBlock Text="連接帳號" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Username" MaxLength="255" Margin="0,0,0,14"/>
   <TextBlock Text="新密碼" Style="{StaticResource FieldLabel}"/><Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="White"><PasswordBox x:Name="NewPassword" MaxLength="255" Padding="10,8" BorderThickness="0" Background="Transparent"/></Border><TextBlock Text="留空保留原密碼" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,8"/><CheckBox x:Name="ClearPassword" Content="清空原密碼" Margin="0,0,0,14" Checked="ClearPasswordChanged" Unchecked="ClearPasswordChanged"/>
   <TextBlock Text="到期時間（選填）" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="Expiration" Language="zh-TW"/>
  </StackPanel></Border></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="Error" Foreground="#C75353" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True"/><Button Content="儲存" Click="SaveClick" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel></StackPanel>
 </Grid>
</Window>
