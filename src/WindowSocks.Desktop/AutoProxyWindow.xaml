<Window x:Class="WindowSocks.Desktop.AutoProxyWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="自動代理" Width="900" Height="820" MinWidth="760" MinHeight="650" WindowStartupLocation="CenterOwner" AllowDrop="True" PreviewDragEnter="ProgramDragOver" PreviewDragOver="ProgramDragOver" PreviewDrop="ProgramDrop">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="自動代理" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PoolSummary" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Padding="22"><StackPanel>
   <TextBlock Text="目標類型" Style="{StaticResource FieldLabel}"/>
   <ComboBox x:Name="Mode" SelectedIndex="0" SelectionChanged="ModeChanged" Margin="0,0,0,18"><ComboBoxItem Content="模擬器"/><ComboBoxItem Content="遊戲／程式 · 自動接續"/><ComboBoxItem Content="虛擬機 · VMware Workstation"/></ComboBox>
   <StackPanel x:Name="EmulatorPanel">
    <TextBlock Text="分配方式" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="AllocationMode" SelectedIndex="0" SelectionChanged="AllocationChanged" Margin="0,0,0,16"><ComboBoxItem Content="自動分配 · 依啟動順序"/><ComboBoxItem Content="進階：固定窗口編號"/></ComboBox>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Vendor" SelectedIndex="0" SelectionChanged="VendorChanged" Margin="0,0,10,0"><ComboBoxItem Content="雷電模擬器"/><ComboBoxItem Content="其他模擬器 · MuMu"/></ComboBox><TextBox x:Name="EmulatorPath" Grid.Column="1" Tag="選擇模擬器管理程式" ToolTip="雷電：ldconsole.exe／dnconsole.exe；MuMu：MuMuManager.exe"/><Button Grid.Column="2" Content="選擇位置" Click="BrowseEmulator" Margin="10,0,0,0"/></Grid>
    <WrapPanel Margin="0,0,0,12"><Button x:Name="ReadInstances" Content="讀取窗口" Click="ReadEmulators"/><StackPanel x:Name="FixedActions" Orientation="Horizontal"><TextBox x:Name="WindowIndex" Width="90" Tag="窗口編號" Margin="0,0,8,0"/><Button Content="加入編號" Click="AddEmulator"/><Button x:Name="DistributeButton" Content="依編號配置" Click="DistributeEmulators" Margin="0"/></StackPanel></WrapPanel>
    <StackPanel x:Name="FixedMappingPanel"><Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><DataGrid x:Name="MappingGrid" IsReadOnly="False" RowHeight="54" Height="270" SelectionMode="Single"><DataGrid.Columns>
     <DataGridTextColumn Header="模擬器 / 編號" Binding="{Binding Identity}" IsReadOnly="True" Width="145" ElementStyle="{StaticResource CellText}"/>
     <DataGridTextColumn Header="窗口" Binding="{Binding Name}" IsReadOnly="True" Width="1*" MinWidth="100" ElementStyle="{StaticResource CellText}"/>
     <DataGridTemplateColumn Header="固定代理 · 可多窗口共用" Width="2*" MinWidth="225"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ProxyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SelectedLabel}" MinHeight="32" Padding="6,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid></Border>
    <TextBlock Text="依模擬器原始編號固定對應，未啟動也保留。選相同節點即可共用 IP。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,16"/>
    </StackPanel>
   </StackPanel>
   <StackPanel x:Name="ProgramPanel" Margin="0,0,0,18">
    <Button Content="桌面沙盒多開…" Click="OpenSandboxMode" HorizontalAlignment="Left" Margin="0,0,0,14"/>
    <TextBlock x:Name="PatternLabel" Text="登入器或程式" Style="{StaticResource FieldLabel}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Pattern" Tag="例如 Login.exe 或完整路徑" TextChanged="ProgramChanged" ToolTip="填檔名會匹配所有同名程式；填完整路徑只匹配該位置。支援 .exe 與 .bin。"/><Button x:Name="BrowseProgramButton" Grid.Column="1" Content="選擇檔案" Click="BrowseProgram" Margin="10,0,0,0"/></Grid>
    <TextBlock Text="可將桌面遊戲捷徑或 .exe／.bin 拖入此視窗，自動帶入遊戲位置。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
    <TextBlock x:Name="MatchHint" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
    <Expander x:Name="ProgramAdvanced" Header="進階：指定登入後的遊戲" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,0"><StackPanel Margin="6,10,0,0">
     <CheckBox x:Name="SpecifyClient" Content="指定遊戲執行檔，與登入器共用 IP" Checked="ProgramChanged" Unchecked="ProgramChanged" Margin="0,0,0,10"/>
     <StackPanel x:Name="ClientPanel" Visibility="Collapsed"><TextBlock Text="遊戲執行檔完整路徑" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ClientPath" Tag="D:\Game\Client.exe"/><Button Grid.Column="1" Content="選擇檔案" Click="BrowseClient" Margin="10,0,0,0"/></Grid><TextBlock Text="上方登入器也須填完整路徑。僅接管這兩個指定程式；請先儲存規則，再開啟登入器。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    </StackPanel></Expander>
   </StackPanel>
   <StackPanel x:Name="LineCapacityPanel" Margin="0,0,0,18">
    <TextBlock Text="線路分配數量" FontWeight="SemiBold"/>
    <TextBlock Text="窗口自動對應線路；直接修改單條數量，或勾選多條後批量套用。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <WrapPanel Margin="0,0,0,10"><Button Content="全選" Click="SelectAllCapacities" Padding="10,7"/><Button Content="清除勾選" Click="ClearCapacitySelection" Padding="10,7"/><TextBox x:Name="BatchCapacity" Width="54" Text="1" TextAlignment="Center" Margin="6,0,8,0" ToolTip="勾選線路可分配的目標數量，0–10"/><Button x:Name="ApplyCapacityButton" Content="套用至勾選線路" Click="ApplyCapacityBatch" Padding="10,7" Margin="0"/></WrapPanel>
    <DataGrid x:Name="CapacityGrid" IsReadOnly="False" MaxHeight="225" MinHeight="80" RowHeight="44" SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True" SizeChanged="CapacityGridSizeChanged"><DataGrid.Columns>
     <DataGridTemplateColumn Header="選取" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="線路" Binding="{Binding Label}" Width="*" MinWidth="180" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
     <DataGridTextColumn Header="已分配" Binding="{Binding Used}" Width="75" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
     <DataGridTemplateColumn Header="可分配數量" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding CountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="66" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,4" TextAlignment="Center" ToolTip="0–10；降低數量會保留既有窗口 IP"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid>
    <TextBlock x:Name="CapacityHint" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
   <Grid x:Name="FixedLimitPanel" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="LimitLabel" Text="依編號配置時，每個節點的窗口數"/><TextBlock x:Name="LimitHint" Text="僅供快速配置；表格可逐條調整" Style="{StaticResource FieldLabel}" Margin="0,5,0,0"/></StackPanel><TextBox Grid.Column="1" x:Name="Limit" Text="1" TextAlignment="Center"/></Grid>
   <CheckBox x:Name="EnableRule" Content="儲存後立即啟用" IsChecked="True" Margin="0,0,0,12"/>
   <TextBlock x:Name="Children" Text="登入後自動接續 · 沿用相同 IP" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
   <Border Background="#F5F7FD" CornerRadius="8" Padding="12" Margin="0,18,0,0"><TextBlock x:Name="ModeNote" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/></Border>
   <Expander Header="運作方式與限制" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"><StackPanel Margin="6,10,6,0"><TextBlock Text="依代理清單順序分配，保留既有出口；TCP／UDP 檢測通過後才放行，失敗時保持封鎖並重試。既有遊戲連線需重新建立。" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="程序檔名與完整路徑皆會先攔截符合規則的新程序；登入後的遊戲依啟動關係自動接續，仍使用原 IP 與同一個名額。修改規則會暫停原有自動綁定。" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="所有程序結束後保留約十秒供交接，再釋放名額。若遊戲由獨立系統服務啟動而無法確認來源，須另設遊戲路徑規則或使用全局代理。橋接網卡模擬器仍需實測。" TextWrapping="Wrap"/></StackPanel></Expander>
  </StackPanel></Border></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="Error" Foreground="#C75353" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True"/><Button x:Name="SaveRuleButton" Content="儲存配置" Style="{StaticResource PrimaryButton}" Click="Confirm" IsDefault="True" Margin="0"/></StackPanel></StackPanel>
 </Grid>
</Window>
